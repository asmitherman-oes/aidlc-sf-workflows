{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "salesforce-dx": {
      "command": "npx",
      "args": [
        "-y",
        "@salesforce/mcp",
        "--orgs",
        "DEFAULT_TARGET_ORG,DEFAULT_TARGET_DEV_HUB",
        "--toolsets",
        "orgs,metadata,data,users,testing,code-analysis,lwc-experts,aura-experts,scale-products,experts-validation",
        "--allow-non-ga-tools"
      ]
    }
  }
}
